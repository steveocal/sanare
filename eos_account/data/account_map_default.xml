<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Defaults keyed on account type; refine per account after install. -->
        <record id="map_income" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">income</field>
            <field name="category">revenue</field>
        </record>
        <record id="map_income_other" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">income_other</field>
            <field name="category">revenue</field>
        </record>
        <record id="map_cogs" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">expense_direct_cost</field>
            <field name="category">cogs</field>
        </record>
        <record id="map_expense" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">expense</field>
            <field name="category">other_opex</field>
        </record>
        <record id="map_depreciation" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">expense_depreciation</field>
            <field name="category">other_capex</field>
        </record>
        <record id="map_cash" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">asset_cash</field>
            <field name="category">cash</field>
        </record>
        <record id="map_inventory" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">asset_current</field>
            <field name="category">inventory_value</field>
        </record>
        <record id="map_fixed_asset" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">asset_fixed</field>
            <field name="category">other_capex</field>
        </record>
        <record id="map_equity" model="eos.account.map">
            <field name="sequence">100</field>
            <field name="account_type">equity</field>
            <field name="category">capital_in</field>
        </record>
    </data>
</odoo>
