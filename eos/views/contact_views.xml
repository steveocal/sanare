<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Graph + Pivot for the main Contacts app (all contacts). Priority 50
         so these, not the hospital-specific ones (100), are the default
         res.partner graph/pivot elsewhere. -->
    <record id="view_partner_graph_eos" model="ir.ui.view">
        <field name="name">res.partner.graph.eos</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <graph string="Contacts" type="bar">
                <field name="country_id"/>
            </graph>
        </field>
    </record>

    <record id="view_partner_pivot_eos" model="ir.ui.view">
        <field name="name">res.partner.pivot.eos</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Contacts">
                <field name="country_id" type="row"/>
                <field name="is_company" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Bound through view_ids (after list/kanban/form/map), like gmap_view
         does, so a Contacts upgrade does not drop them. -->
    <record id="contacts_action_view_graph_eos" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_partner_graph_eos"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>
    <record id="contacts_action_view_pivot_eos" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_partner_pivot_eos"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>
</odoo>
