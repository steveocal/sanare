<odoo>
    <!-- KPI DICTIONARY -->
    <record id="view_eos_kpi_tree" model="ir.ui.view">
        <field name="name">eos.kpi.tree</field>
        <field name="model">eos.kpi</field>
        <field name="arch" type="xml">
            <list string="KPI Dictionary">
                <field name="name"/>
                <field name="code"/>
                <field name="source"/>
                <field name="owner"/>
                <field name="frequency"/>
                <field name="report_section"/>
            </list>
        </field>
    </record>

    <record id="view_eos_kpi_form" model="ir.ui.view">
        <field name="name">eos.kpi.form</field>
        <field name="model">eos.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="source"/>
                        <field name="owner"/>
                        <field name="frequency"/>
                        <field name="target"/>
                        <field name="report_section"/>
                    </group>
                    <group string="Definition">
                        <field name="definition" nolabel="1"/>
                    </group>
                    <group string="Calculation / Logic">
                        <field name="calculation" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- KPI HISTORY / VALUES -->
    <record id="view_eos_kpi_value_tree" model="ir.ui.view">
        <field name="name">eos.kpi.value.tree</field>
        <field name="model">eos.kpi.value</field>
        <field name="arch" type="xml">
            <list string="KPI History">
                <field name="period"/>
                <field name="market_id"/>
                <field name="kpi_id"/>
                <field name="value"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_eos_kpi_value_form" model="ir.ui.view">
        <field name="name">eos.kpi.value.form</field>
        <field name="model">eos.kpi.value</field>
        <field name="arch" type="xml">
            <form string="KPI Value">
                <sheet>
                    <group>
                        <field name="period"/>
                        <field name="market_id"/>
                        <field name="kpi_id"/>
                        <field name="value"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eos_kpi_value_graph" model="ir.ui.view">
        <field name="name">eos.kpi.value.graph</field>
        <field name="model">eos.kpi.value</field>
        <field name="arch" type="xml">
            <graph string="KPI History" type="line" sample="1">
                <field name="period" interval="month"/>
                <field name="kpi_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_eos_kpi_value_pivot" model="ir.ui.view">
        <field name="name">eos.kpi.value.pivot</field>
        <field name="model">eos.kpi.value</field>
        <field name="arch" type="xml">
            <pivot string="KPI History" sample="1">
                <field name="kpi_id" type="row"/>
                <field name="market_id" type="row"/>
                <field name="period" interval="month" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
