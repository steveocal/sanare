<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_dms" model="ir.ui.view">
        <field name="name">sale.order.form.dms</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']" position="after">
                <group name="dms_documents" string="Documents">
                    <field name="dms_pre_document_id"
                           options="{'no_quick_create': True}"/>
                    <field name="dms_post_document_id"
                           options="{'no_quick_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
