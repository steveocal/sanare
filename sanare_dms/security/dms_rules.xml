<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============ sanare.document ============ -->
    <record id="rule_dms_document_manager" model="ir.rule">
        <field name="name">Document: manager full access</field>
        <field name="model_id" ref="model_sanare_document"/>
        <field name="groups" eval="[(4, ref('group_dms_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_dms_document_user_read" model="ir.rule">
        <field name="name">Document: read own / shared / public</field>
        <field name="model_id" ref="model_sanare_document"/>
        <field name="groups" eval="[(4, ref('group_dms_user'))]"/>
        <field name="domain_force">
            ['|', '|', '|',
                ('owner_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('effective_visibility', '=', 'public'),
                ('allowed_user_ids', 'in', [user.id])]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_dms_document_user_write" model="ir.rule">
        <field name="name">Document: write own / shared-for-edit</field>
