<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <record id="module_category_dms" model="ir.module.category">
            <field name="name">Document Management</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_dms" model="res.groups.privilege">
            <field name="name">Documents</field>
            <field name="category_id" ref="module_category_dms"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_dms_user" model="res.groups">
            <field name="name">Document User</field>
            <field name="privilege_id" ref="privilege_dms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dms_approver" model="res.groups">
            <field name="name">Document Approver</field>
            <field name="privilege_id" ref="privilege_dms"/>
            <field name="implied_ids" eval="[(4, ref('group_dms_user'))]"/>
        </record>

        <record id="group_dms_manager" model="res.groups">
            <field name="name">Document Manager</field>
            <field name="privilege_id" ref="privilege_dms"/>
            <field name="implied_ids" eval="[(4, ref('group_dms_approver'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>

    <!-- Every internal user is a Document User (can see the app, manage their
         own documents, read shared + public ones). Applied on install and on
         every module update. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sanare_dms.group_dms_user'))]"/>
    </record>

</odoo>
