<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_dms_document" model="ir.actions.report">
        <field name="name">Document</field>
        <field name="model">sanare.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sanare_dms.report_document</field>
        <field name="report_file">sanare_dms.report_document</field>
        <field name="binding_model_id" ref="model_sanare_document"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- One .article per top-level selected doc, not per node -
                     _prepare_html() (base/models/ir_actions_report.py) treats
                     every ".article" div as a separate wkhtmltopdf "body"
                     that starts on its own page. Nested children are only
                     ever rendered *inside* this single wrapper via
                     report_document_body, so a parent with descendants comes
                     out as one continuous flowing document instead of a new
                     page per nested doc. -->
                <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
                     style="margin: 12mm;">
                    <!-- Not a class="footer" div: Odoo's normal wkhtmltopdf
                         header/footer pipeline (a separate footer-html page,
                         stitched in via the minimal_layout subst() JS trick)
                         turned out to be broken in this environment -
                         verified against an unrelated, unmodified core Odoo
                         report (an invoice PDF) on the same box, so it's a
                         pre-existing infra issue, not something introduced
                         here. Using position:fixed instead. This still has a
                         real limitation on this box, verified directly: it
                         only shows on the LAST physical page of a multi-page
                         document, not repeated on every page (wkhtmltopdf
                         here renders the whole document as one continuous
                         canvas before slicing it into pages, rather than
                         truly re-flowing position:fixed content per page) -
                         acceptable given these are typically short documents
                         and it's strictly better than no footer at all.
                         minimal_layout's own wrapper sets `html{height:0}`
                         (meant only for the header/footer file, but it also
                         wraps this body), which silently collapses
                         position:fixed's positioning box to nothing - the
                         inline !important override below is required, not
                         decorative. -->
                    <style>html { height: auto !important; }</style>
                    <div style="position: fixed; bottom: 0; left: 0; right: 0;
                                 font-size: 8px; color: #999; text-align: right;
                                 border-top: 1px solid #ddd; padding-top: 2px;">
                        <span t-out="doc.name"/> · v<span t-out="doc.version_number"/>
                    </div>
                    <t t-call="sanare_dms.report_document_body">
                        <t t-set="doc" t-value="doc"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Recursive: renders `doc`'s own content, then every child with
         display_in_print set, each in turn calling this same template one
         level deeper - printing a folder (or an html/markdown page) pulls in
         its full descendant subtree, in tree order, and a child with the
         flag off is skipped along with its own subtree rather than left
         "orphaned" with no parent section above it. All levels render into
         the *same* .article wrapper (see report_document) so the whole
         subtree flows as one combined document; page breaks only happen
         where the content naturally overflows a page, never forced between
         sections. -->
    <template id="report_document_body">
        <!-- No per-section heading/separator, and no name/version/state
             byline - a combined document should read as one continuous
             document, not a stack of labeled sections. Only the printed
             (top-level) document's name belongs anywhere in the output now,
             and only in the footer - see report_document. -->
        <div t-if="doc.content_type == 'html'" t-out="doc.content_html"/>
        <div t-elif="doc.content_type == 'markdown'"
             t-out="doc.content_markdown_html"/>
        <div t-elif="doc.content_type == 'onlyoffice'">
            <p>Office document: <span t-out="doc.file_name"/>
               (<span t-out="doc.file_size"/> bytes).</p>
            <p>Open in ONLYOFFICE to view the full contents.</p>
        </div>
        <div t-else="">
            <p t-if="not doc.child_ids.filtered(lambda c: c.display_in_print)">
                This is an empty folder.
            </p>
        </div>
        <t t-foreach="doc.child_ids.filtered(lambda c: c.display_in_print).sorted(key=lambda c: c.sequence)"
           t-as="child">
            <t t-call="sanare_dms.report_document_body">
                <t t-set="doc" t-value="child"/>
            </t>
        </t>
    </template>

</odoo>
