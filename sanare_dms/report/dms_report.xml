<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_dms_document" model="ir.actions.report">
        <field name="name">Document</field>
        <field name="model">sanare.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sanare_dms.report_document</field>
        <field name="report_file">sanare_dms.report_document</field>
        <field name="binding_model_id" ref="model_sanare_document"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- report_layout branches on the top-level printed doc only
                     - a recursed child's own value is never consulted, same
                     rule as its name/version already being footer-only (see
                     report_document_body). All three branches print the
                     document's name in a genuine wkhtmltopdf footer (real
                     per-page-repeated chrome, pinned to the true bottom of
                     the physical page - not the position:fixed-in-body hack
                     this used before, which only ever showed on the LAST
                     page and rendered wherever the content happened to end,
                     not the actual page bottom; see
                     report/wkhtmltopdf_header_footer_fix.xml for why the
                     real mechanism now works on this box) - never as a body
                     heading: 'internal'/'external' never set
                     layout_document_title.

                     Exactly one class="footer" div per top-level document is
                     required for correct multi-document batch prints (Odoo's
                     own _prepare_html() collects every class="footer" div in
                     the whole combined print job into one flat list, and the
                     fixed subst() script picks entry N for document N by
                     temp-file index - two footer divs on one document would
                     shift every later document's footer by one). external_
                     layout already provides its own single footer div (with
                     a built-in name-in-footer feature, display_name_in_footer)
                     so it reuses that instead of adding a second one;
                     internal_layout has no footer at all (header only), and
                     'none' has neither, so both add exactly one of their
                     own via report_document_footer. -->
                <t t-if="doc.report_layout == 'internal'">
                    <t t-call="web.internal_layout">
                        <t t-set="o" t-value="doc"/>
                        <div class="page">
                            <t t-call="sanare_dms.report_document_footer">
                                <t t-set="doc" t-value="doc"/>
                            </t>
                            <t t-call="sanare_dms.report_document_body">
                                <t t-set="doc" t-value="doc"/>
                            </t>
                        </div>
                    </t>
                </t>
                <t t-elif="doc.report_layout == 'external'">
                    <t t-call="web.external_layout">
                        <t t-set="o" t-value="doc"/>
                        <t t-set="display_name_in_footer" t-value="True"/>
                        <div class="page">
                            <t t-call="sanare_dms.report_document_body">
                                <t t-set="doc" t-value="doc"/>
                            </t>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <!-- One .article per top-level selected doc, not per node
                         - _prepare_html() (base/models/ir_actions_report.py)
                         treats every ".article" div as a separate wkhtmltopdf
                         "body" that starts on its own page. Nested children
                         are only ever rendered *inside* this single wrapper
                         via report_document_body, so a parent with
                         descendants comes out as one continuous flowing
                         document instead of a new page per nested doc. -->
                    <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
                         style="margin: 12mm;">
                        <t t-call="sanare_dms.report_document_footer">
                            <t t-set="doc" t-value="doc"/>
                        </t>
                        <t t-call="sanare_dms.report_document_body">
                            <t t-set="doc" t-value="doc"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Used by the 'internal' and 'none' report_layout branches above (see
         their comment for why 'external' doesn't use this) - a plain,
         unstyled class="footer" div. Placement in the source markup doesn't
         matter: _prepare_html() finds it by class anywhere in the page and
         moves it into wkhtmltopdf's real footer pass (see
         report/wkhtmltopdf_header_footer_fix.xml), which is what actually
         pins it to the true bottom of every physical page - nothing here
         needs to do that positioning itself. -->
    <template id="report_document_footer">
        <div class="footer" style="font-size: 8px; color: #999; text-align: right;">
            <span t-out="doc.name"/> (v<span t-out="doc.version_number"/>)
        </div>
    </template>

    <!-- Recursive: renders `doc`'s own content, then every child with
         display_in_print set, each in turn calling this same template one
         level deeper - printing a folder (or an html/markdown page) pulls in
         its full descendant subtree, in tree order, and a child with the
         flag off is skipped along with its own subtree rather than left
         "orphaned" with no parent section above it. All levels render into
         the *same* .article wrapper (see report_document) so the whole
         subtree flows as one combined document; page breaks only happen
         where the content naturally overflows a page, never forced between
         sections. -->
    <template id="report_document_body">
        <!-- No per-section heading/separator, and no name/version/state
             byline - a combined document should read as one continuous
             document, not a stack of labeled sections. Only the printed
             (top-level) document's name belongs anywhere in the output now,
             and only in the footer - see report_document. -->
        <!-- Resolved, not raw: an embedded-document marker in content_html
             is an empty div until _resolve_embedded_refs expands it - see
             that method's docstring. -->
        <div t-if="doc.content_type in ('html', 'knowledge_html')"
             t-out="doc._resolve_embedded_refs(doc.content_html)"/>
        <div t-elif="doc.content_type == 'markdown'"
             t-out="doc.content_markdown_html"/>
        <div t-elif="doc.content_type == 'onlyoffice'">
            <p>Office document: <span t-out="doc.file_name"/>
               (<span t-out="doc.file_size"/> bytes).</p>
            <p>Open in ONLYOFFICE to view the full contents.</p>
        </div>
        <div t-else="">
            <p t-if="not doc.child_ids.filtered(lambda c: c.display_in_print)">
                This is an empty folder.
            </p>
        </div>
        <t t-foreach="doc.child_ids.filtered(lambda c: c.display_in_print).sorted(key=lambda c: c.sequence)"
           t-as="child">
            <t t-call="sanare_dms.report_document_body">
                <t t-set="doc" t-value="child"/>
            </t>
        </t>
    </template>

</odoo>
