<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Example categories -->
    <record id="category_policies" model="sanare.document.category">
        <field name="name">Policies &amp; Procedures</field>
    </record>
    <record id="category_contracts" model="sanare.document.category">
        <field name="name">Contracts</field>
    </record>
    <record id="category_marketing" model="sanare.document.category">
        <field name="name">Marketing</field>
    </record>
    <record id="category_public" model="sanare.document.category">
        <field name="name">Published / Public</field>
    </record>

    <!-- A ready-to-use single-step approval rule.
         Documents with no category rule and no ancestor-folder rule fall back
         to a single "any Document Manager" step automatically, so this rule is
         a starting template rather than a hard requirement. -->
    <record id="approval_rule_standard" model="sanare.document.approval.rule">
        <field name="name">Standard Approval</field>
    </record>
    <record id="approval_rule_standard_line" model="sanare.document.approval.rule.line">
        <field name="rule_id" ref="approval_rule_standard"/>
        <field name="sequence">10</field>
        <field name="name">Manager sign-off</field>
        <field name="approver_type">group</field>
        <field name="group_id" ref="group_dms_manager"/>
        <field name="approval_mode">any</field>
    </record>

    <!-- Email templates: a plain folder for organising them. A document is
         "an email" once its Email Subject is set (Email tab on the form);
         the "Send Email" header button then appears. Body = the document's
         own content. -->
    <record id="doc_folder_email_templates" model="sanare.document">
        <field name="name">Email Templates</field>
        <field name="content_type">folder</field>
        <field name="visibility">public</field>
        <field name="visibility_inherited" eval="False"/>
    </record>
    <record id="doc_intro_email" model="sanare.document">
        <field name="name">Introduction Email</field>
        <field name="content_type">knowledge_html</field>
        <field name="parent_id" ref="doc_folder_email_templates"/>
        <field name="is_template" eval="True"/>
        <field name="visibility">public</field>
        <field name="visibility_inherited" eval="False"/>
        <field name="email_subject">Introduction from Sanare</field>
        <field name="content_html" type="html">
            <div>
                <p>Dear Sir/Madam,</p>
                <p>It was a pleasure connecting. I wanted to introduce myself and
                   share a little about what we do at Sanare.</p>
                <p>I would welcome the chance to discuss how we might work together.
                   Please let me know a time that suits you.</p>
                <p>Kind regards,<br/>The Sanare Team</p>
            </div>
        </field>
    </record>

</odoo>
