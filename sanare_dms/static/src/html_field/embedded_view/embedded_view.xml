<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <!-- Rendered on <div data-embedded="sanareView"> in a document body.
         data-embedded-props is the captured view descriptor
         {resModel, viewType, views, domain, context, searchState, title}
         plus persisted UI state {height, zoom, viewType}. -->
    <t t-name="sanare_dms.EmbeddedView">
        <div class="o_sanare_embedded_view card my-2" contenteditable="false">
            <div class="card-header d-flex align-items-center gap-1 py-1">
                <i class="fa fa-table text-muted" role="img"/>
                <span class="fw-bold text-truncate flex-grow-1" t-esc="d.title || d.resModel"/>

                <div class="btn-group btn-group-sm" t-if="switchableTypes.length &gt; 1">
                    <button t-foreach="switchableTypes" t-as="v" t-key="v.type"
                            type="button" class="btn btn-light"
                            t-att-class="{ active: v.type === state.viewType }"
                            t-att-title="v.label"
                            t-on-click="() => this.setViewType(v.type)">
                        <i class="fa" t-att-class="v.icon" role="img"/>
                    </button>
                </div>

                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-light" title="Zoom out"
                            t-on-click="() => this.zoomBy(-0.1)">
                        <i class="fa fa-search-minus" role="img"/>
                    </button>
                    <button type="button" class="btn btn-light" title="Reset zoom"
                            t-on-click="() => this.setZoom(1)" t-esc="zoomPct"/>
                    <button type="button" class="btn btn-light" title="Zoom in"
                            t-on-click="() => this.zoomBy(0.1)">
                        <i class="fa fa-search-plus" role="img"/>
                    </button>
                </div>

                <button type="button" class="btn btn-light btn-sm"
                        t-att-title="snapshotLabel"
                        t-att-disabled="state.snapping"
                        t-on-click="() => this.snapshot()">
                    <i class="fa"
                       t-att-class="state.snapping ? 'fa-spinner fa-spin' : 'fa-camera'"
                       role="img"/>
                </button>

                <button type="button" class="btn btn-sm btn-link p-0"
                        title="Open in full view" t-on-click="openInFull">
                    <i class="fa fa-external-link" role="img"/>
                </button>
            </div>
            <div class="card-body p-0 o_sanare_embedded_view_body"
                 t-att-style="bodyStyle"
                 t-on-mousedown="onBodyMouseDown" t-on-mouseup="onResize">
                <div t-if="ready" class="o_sanare_view_zoom" t-ref="capture"
                     t-att-style="'zoom:' + state.zoom">
                    <View t-props="viewProps" t-key="state.viewType"/>
                </div>
                <div t-else="" class="text-muted fst-italic p-3">
                    This embedded view can't be shown here.
                    <a href="#" t-on-click.prevent="openInFull">Open it in full</a>.
                </div>
            </div>
        </div>
    </t>

</templates>
