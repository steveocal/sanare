<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">

    <!-- Rendered once at insertion time (renderToString), becomes the
         stored marker in content_html. data-embedded-props holds the
         block's whole state (subject + recipients + last send result) -
         it is the only thing persisted; the component reads/writes it
         live. -->
    <t t-name="sanare_dms.EmbeddedEmailSendBlueprint">
        <div data-embedded="sanareEmailSend" data-oe-protected="true" contenteditable="false"
             t-att-data-embedded-props="embeddedProps" class="o-contenteditable-false"/>
    </t>

    <t t-name="sanare_dms.EmbeddedEmailSend">
        <div class="o_sanare_email_send card my-2">
            <div class="card-header d-flex align-items-center py-1">
                <i class="fa fa-paper-plane me-2 text-muted" role="img"/>
                <span class="fw-bold">Send Email</span>
                <span class="ms-auto small" t-att-class="lastSendClass" t-esc="lastSendLabel"/>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Subject</label>
                    <input type="text" class="form-control form-control-sm"
                           t-att-value="state.subject" t-on-input="onSubjectInput"
                           placeholder="Subject line - {{placeholders}} allowed"/>
                </div>
                <t t-foreach="rows" t-as="row" t-key="row.field">
                    <div class="o_sanare_email_recipients mb-2 d-flex align-items-start">
                        <label class="form-label small text-muted mb-0 pt-1 me-2"
                               style="width: 3rem;" t-esc="row.label"/>
                        <div class="flex-grow-1">
                            <TagsList tags="tagsFor(row.field)"/>
                            <AutoComplete
                                value="inputs[row.field]"
                                sources="sourcesFor(row.field)"
                                placeholder="'Search a contact, or type a new name…'"
                                onInput="(args) => this.onInput(row.field, args)"
                                onSelect="(option) => this.onSelect(row.field, option)"/>
                        </div>
                    </div>
                </t>
                <div class="d-flex align-items-center mt-2">
                    <button type="button" class="btn btn-sm btn-primary"
                            t-on-click="send" t-att-disabled="ui.sending">
                        <i class="fa me-1"
                           t-att-class="ui.sending ? 'fa-spinner fa-spin' : 'fa-paper-plane'"
                           role="img"/>
                        Send
                    </button>
                    <span class="small text-muted ms-3"
                          t-if="state.lastSend and state.lastSend.error"
                          t-esc="state.lastSend.error"/>
                </div>
            </div>
        </div>
    </t>

</templates>
