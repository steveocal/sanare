<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sanare_dms.DmsBrowser">
        <div class="o_dms_browser d-flex flex-column h-100" t-att-class="props.className">

            <!-- toolbar -->
            <div class="o_dms_toolbar d-flex align-items-center gap-2 p-2 border-bottom">
                <ol class="breadcrumb mb-0 flex-grow-1">
                    <li class="breadcrumb-item">
                        <a href="#" t-on-click.prevent="() => this.selectFolder(false)"
                           t-att-class="{ 'o_dms_drop_target': state.dragOverId === 'root' }"
                           t-on-dragover="(ev) => this.onFolderDragOver(false, ev)"
                           t-on-dragleave="() => this.onFolderDragLeave()"
                           t-on-drop="(ev) => this.onFolderDrop(false, ev)">
                            <i class="fa fa-database me-1"/>Documents
                        </a>
                    </li>
                    <t t-if="state.viewMode === 'folder'">
                        <t t-foreach="state.breadcrumb" t-as="crumb" t-key="crumb.id">
                            <li class="breadcrumb-item"
                                t-att-class="{ active: crumb_last }">
                                <a t-if="!crumb_last" href="#"
                                   t-on-click.prevent="() => this.selectFolder(crumb.id)"
                                   t-esc="crumb.name"/>
                                <span t-else="" t-esc="crumb.name"/>
                            </li>
                        </t>
                    </t>
                    <li t-else="" class="breadcrumb-item active">
                        <i class="fa fa-magic me-1"/>Templates
                    </li>
                </ol>

                <button class="btn btn-sm btn-secondary" t-on-click="() => this.startNewFolder()">
                    <i class="fa fa-folder-o me-1"/>New Folder
                </button>

                <Dropdown>
                    <button class="btn btn-sm btn-primary">
                        <i class="fa fa-plus me-1"/>New Document <i class="fa fa-caret-down ms-1"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.newTypesFor(state.containerContentType)" t-as="nt" t-key="nt[0]">
                            <DropdownItem onSelected="() => this.newDocument(nt[0])">
                                <t t-esc="nt[1]"/>
                            </DropdownItem>
                        </t>
                        <div class="dropdown-divider"/>
                        <DropdownItem onSelected="() => this.openTemplatePicker()">
                            <i class="fa fa-magic me-1"/>From Template…
                        </DropdownItem>
                    </t>
                </Dropdown>

                <button class="btn btn-sm btn-secondary" title="Copy (Ctrl+C)"
                        t-att-disabled="!state.selection.size"
                        t-on-click="() => this.copySelection()">
                    <i class="fa fa-clone"/>
                </button>
                <button class="btn btn-sm btn-secondary" title="Paste (Ctrl+V)"
                        t-att-disabled="!state.clipboard.ids.length"
                        t-on-click="() => this.pasteClipboard()">
                    <i class="fa fa-clipboard"/>
                    <span t-if="state.clipboard.ids.length" class="badge text-bg-light ms-1"
                          t-esc="state.clipboard.ids.length"/>
                </button>

                <button class="btn btn-sm btn-secondary" title="Refresh"
                        t-on-click="() => this.refresh()">
                    <i class="fa fa-refresh"/>
                </button>
            </div>

            <!-- body -->
            <div class="o_dms_body d-flex flex-grow-1 overflow-hidden">

                <!-- tree pane -->
                <div class="o_dms_tree border-end p-1 overflow-auto">
                    <div class="o_dms_tree_row o_dms_root d-flex align-items-center px-2 py-1 rounded"
                         t-att-class="{
                             'o_dms_selected': state.selectedId === false,
                             'o_dms_drop_target': state.dragOverId === 'root' }"
                         t-on-click="() => this.selectFolder(false)"
                         t-on-dragover="(ev) => this.onFolderDragOver(false, ev)"
                         t-on-dragleave="() => this.onFolderDragLeave()"
                         t-on-drop="(ev) => this.onFolderDrop(false, ev)">
                        <i class="fa fa-database me-2 text-primary"/>
                        <span class="fw-bold">Documents</span>
                    </div>
                    <div class="o_dms_tree_row o_dms_templates_root d-flex align-items-center px-2 py-1 rounded mb-2"
                         t-att-class="{
                             'o_dms_selected': state.viewMode === 'templates',
                             'o_dms_drop_target': state.templatesDragOver }"
                         t-on-click="() => this.selectTemplates()"
                         t-on-dragover="(ev) => this.onTemplatesDragOver(ev)"
                         t-on-dragleave="() => this.onTemplatesDragLeave()"
                         t-on-drop="(ev) => this.onTemplatesDrop(ev)">
                        <i class="fa fa-magic me-2 text-primary"/>
                        <span class="fw-bold">Templates</span>
                        <span t-if="state.templates.length" class="badge text-bg-light ms-2" t-esc="state.templates.length"/>
                    </div>
                    <div t-if="state.loadingTree" class="text-muted small px-2 py-1">Loading…</div>
                    <t t-foreach="state.tree" t-as="node" t-key="node.id">
                        <DmsTreeNode node="node" depth="0"/>
                    </t>
                    <div t-if="!state.loadingTree and !state.tree.length"
                         class="text-muted small px-2 py-1">No folders yet</div>
                </div>

                <!-- detail / list pane -->
                <div class="o_dms_list flex-grow-1 overflow-auto" t-if="state.viewMode === 'folder'">
                    <div class="o_dms_doc_form h-100" t-if="state.detail">
                        <DmsDocForm resId="state.detail.id" t-key="state.detail.id"
                                    onSaved="() => this.refresh()"/>
                    </div>
                    <table class="table table-sm table-hover mb-0 o_dms_table" t-else="">
                        <thead class="o_dms_thead">
                            <tr>
                                <th style="width: 45%">Name</th>
                                <th>Type</th>
                                <th>Owner</th>
                                <th>Visibility</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="state.creatingFolder">
                                <td colspan="7">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-folder-o text-warning"/>
                                        <input type="text" class="form-control form-control-sm w-auto"
                                               placeholder="Folder name…"
                                               t-att-value="state.newFolderName"
                                               t-on-input="(ev) => this.state.newFolderName = ev.target.value"
                                               t-on-keydown="(ev) => this.onNewFolderKeydown(ev)"
                                               t-ref="newFolderInput"/>
                                        <button class="btn btn-sm btn-primary"
                                                t-on-click="() => this.confirmNewFolder()">Create</button>
                                        <button class="btn btn-sm btn-link"
                                                t-on-click="() => this.cancelNewFolder()">Cancel</button>
                                    </div>
                                </td>
                            </tr>

                            <tr t-foreach="state.records" t-as="rec" t-key="rec.id"
                                class="o_dms_row"
                                draggable="true"
                                t-att-class="{
                                    'o_dms_selected': state.selection.has(rec.id),
                                    'o_dms_drop_target': rec.can_have_children and state.dragOverId === rec.id,
                                    'o_dms_is_folder': rec.is_folder }"
                                t-on-click="(ev) => this.onRowClick(rec, ev)"
                                t-on-dblclick="() => this.onRowDblClick(rec)"
                                t-on-dragstart="(ev) => this.onItemDragStart(rec, ev)"
                                t-on-dragover="(ev) => rec.can_have_children ? this.onFolderDragOver(rec.id, ev) : null"
                                t-on-dragleave="() => rec.can_have_children ? this.onFolderDragLeave() : null"
                                t-on-drop="(ev) => rec.can_have_children ? this.onFolderDrop(rec.id, ev) : null">
                                <td>
                                    <i class="fa me-2" t-att-class="this.iconFor(rec) + (rec.is_folder ? ' text-warning' : ' text-muted')"/>
                                    <span t-esc="rec.name"/>
                                    <span t-if="rec.can_have_children and rec.child_count"
                                          class="badge text-bg-light ms-2" t-esc="rec.child_count"/>
                                </td>
                                <td class="text-muted" t-esc="rec.is_folder ? 'Folder' : rec.content_type_label"/>
                                <td class="text-muted" t-esc="rec.owner"/>
                                <td class="text-muted text-capitalize" t-esc="rec.visibility"/>
                                <td>
                                    <span t-if="!rec.is_folder" class="badge"
                                          t-att-class="this.stateClass(rec.state)" t-esc="rec.state_label"/>
                                </td>
                                <td class="text-muted small" t-esc="rec.updated"/>
                                <td class="text-end text-nowrap o_dms_actions">
                                    <span class="o_dms_reorder me-1">
                                        <i class="fa fa-caret-up" title="Move up"
                                           t-on-click="(ev) => { ev.stopPropagation(); this.reorder(rec.id, 'up'); }"/>
                                        <i class="fa fa-caret-down" title="Move down"
                                           t-on-click="(ev) => { ev.stopPropagation(); this.reorder(rec.id, 'down'); }"/>
                                    </span>
                                    <i class="fa fa-print mx-1"
                                       t-att-title="rec.is_folder ? 'Print (includes contents)' : 'Print'"
                                       t-on-click="(ev) => this.printDocument(rec, ev)"/>
                                    <i t-if="!rec.is_folder" class="fa fa-download mx-1" title="Download"
                                       t-on-click="(ev) => this.downloadDocument(rec, ev)"/>
                                    <i t-if="!rec.is_folder" class="fa fa-globe mx-1" title="Toggle publish to website"
                                       t-att-class="{ 'text-success': rec.is_published }"
                                       t-on-click="(ev) => this.togglePublish(rec, ev)"/>
                                    <i class="fa mx-1"
                                       t-att-class="rec.display_in_print ? 'fa-eye' : 'fa-eye-slash text-muted'"
                                       t-att-title="rec.display_in_print ? 'Included when parent is printed - click to exclude' : 'Excluded when parent is printed - click to include'"
                                       t-on-click="(ev) => this.toggleDisplayInPrint(rec, ev)"/>
                                    <i class="fa mx-1"
                                       t-att-class="rec.is_template ? 'fa-magic text-primary' : 'fa-magic text-muted'"
                                       t-att-title="rec.is_template ? 'Template - click to remove' : 'Mark as a template'"
                                       t-on-click="(ev) => this.toggleIsTemplate(rec, ev)"/>
                                    <span t-if="rec.can_have_children" class="mx-1" t-on-click.stop="() => {}">
                                        <Dropdown>
                                            <i class="fa fa-plus-circle" title="Add a document here"/>
                                            <t t-set-slot="content">
                                                <t t-foreach="this.newTypesFor(rec.content_type)" t-as="nt" t-key="nt[0]">
                                                    <DropdownItem onSelected="() => this.newDocument(nt[0], rec.id)">
                                                        <t t-esc="nt[1]"/>
                                                    </DropdownItem>
                                                </t>
                                                <div class="dropdown-divider"/>
                                                <DropdownItem onSelected="() => this.openTemplatePicker(rec.id)">
                                                    <i class="fa fa-magic me-1"/>From Template…
                                                </DropdownItem>
                                            </t>
                                        </Dropdown>
                                    </span>
                                    <i class="fa fa-trash-o mx-1" title="Delete"
                                       t-on-click="(ev) => this.deleteRecord(rec, ev)"/>
                                </td>
                            </tr>

                            <tr t-if="!state.loadingList and !state.records.length and !state.creatingFolder">
                                <td colspan="7" class="text-center text-muted py-4">
                                    This folder is empty. Drag items here, or use “New”.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- templates list pane - flat, not folder-scoped (a
                     template keeps its real parent_id; this is every
                     is_template=True document regardless of where it
                     actually lives - see browser_templates). -->
                <div class="o_dms_list flex-grow-1 overflow-auto" t-else="">
                    <table class="table table-sm table-hover mb-0 o_dms_table">
                        <thead class="o_dms_thead">
                            <tr>
                                <th style="width: 45%">Name</th>
                                <th>Type</th>
                                <th>In Folder</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.templates" t-as="rec" t-key="rec.id"
                                class="o_dms_row"
                                t-on-dblclick="() => this.onRowDblClick(rec)">
                                <td>
                                    <i class="fa me-2" t-att-class="this.iconFor(rec) + (rec.is_folder ? ' text-warning' : ' text-muted')"/>
                                    <span t-esc="rec.name"/>
                                </td>
                                <td class="text-muted" t-esc="rec.is_folder ? 'Folder' : rec.content_type_label"/>
                                <td class="text-muted" t-esc="rec.parent_name or 'Documents'"/>
                                <td class="text-end text-nowrap o_dms_actions">
                                    <i class="fa fa-magic mx-1 text-primary" title="Remove template flag"
                                       t-on-click="(ev) => this.toggleIsTemplate(rec, ev)"/>
                                    <i class="fa fa-trash-o mx-1" title="Delete"
                                       t-on-click="(ev) => this.deleteRecord(rec, ev)"/>
                                </td>
                            </tr>
                            <tr t-if="!state.loadingTemplates and !state.templates.length">
                                <td colspan="4" class="text-center text-muted py-4">
                                    No templates yet. Drag a document onto “Templates” in the
                                    tree, or click the <i class="fa fa-magic"/> icon on any row.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>

    <!-- recursive tree node - a folder (expandable, click loads its
         contents in the flat pane) or a leaf document (no caret,
         dblclick opens its form). Both are draggable for reparenting;
         only folders are drop targets. -->
    <t t-name="sanare_dms.DmsTreeNode">
        <div class="o_dms_tree_row d-flex align-items-center px-1 py-1 rounded"
             t-att-style="'padding-left:' + (props.depth * 14 + 4) + 'px'"
             t-att-class="{ 'o_dms_selected': isSelected, 'o_dms_drop_target': isDragOver }"
             draggable="true"
             t-on-click="() => env.dms.select(props.node.id)"
             t-on-dblclick="() => props.node.is_folder ? null : env.dms.open(props.node.id)"
             t-on-dragstart="(ev) => env.dms.dragStart(props.node, ev)"
             t-on-dragover="(ev) => props.node.can_have_children ? env.dms.dragOver(props.node.id, ev) : null"
             t-on-dragleave="() => props.node.can_have_children ? env.dms.dragLeave() : null"
             t-on-drop="(ev) => props.node.can_have_children ? env.dms.drop(props.node.id, ev) : null">
            <span class="o_dms_caret" title="Expand/collapse"
                  t-on-click.stop="() => env.dms.toggle(props.node)">
                <i t-if="props.node.has_children" class="fa"
                   t-att-class="props.node.expanded ? 'fa-minus-square-o' : 'fa-plus-square-o'"/>
                <i t-else="" class="fa fa-fw"/>
            </span>
            <i class="fa me-2" t-att-class="icon + (props.node.is_folder ? ' text-warning' : ' text-muted')"/>
            <span class="text-truncate flex-grow-1" t-esc="props.node.name"/>
            <i t-if="props.node.loading" class="fa fa-spinner fa-spin ms-2 small"/>

            <span t-if="props.node.can_have_children" class="o_dms_tree_row_actions ms-2"
                  t-on-click.stop="() => {}">
                <Dropdown>
                    <i class="fa fa-plus-circle" title="Add a document here"/>
                    <t t-set-slot="content">
                        <t t-foreach="env.dms.newTypesFor(props.node.content_type)" t-as="nt" t-key="nt[0]">
                            <DropdownItem onSelected="() => env.dms.newDocument(nt[0], props.node.id)">
                                <t t-esc="nt[1]"/>
                            </DropdownItem>
                        </t>
                        <div class="dropdown-divider"/>
                        <DropdownItem onSelected="() => env.dms.openTemplatePicker(props.node.id)">
                            <i class="fa fa-magic me-1"/>From Template…
                        </DropdownItem>
                    </t>
                </Dropdown>
                <i class="fa fa-trash-o ms-2" title="Delete"
                   t-on-click="(ev) => env.dms.deleteRecord(props.node, ev)"/>
            </span>
            <i t-else="" class="fa fa-trash-o o_dms_tree_row_actions ms-2" title="Delete"
               t-on-click="(ev) => env.dms.deleteRecord(props.node, ev)"/>
        </div>
        <t t-if="props.node.expanded and props.node.children">
            <t t-foreach="props.node.children" t-as="child" t-key="child.id">
                <DmsTreeNode node="child" depth="props.depth + 1"/>
            </t>
        </t>
    </t>

    <t t-name="sanare_dms.DmsDocForm">
        <View t-if="!state.failed" t-props="viewProps"/>
        <div t-else="" class="text-muted fst-italic p-3">
            This document can't be shown here.
        </div>
    </t>

</templates>
